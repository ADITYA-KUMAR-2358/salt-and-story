# Copy to .env and fill in. Never commit .env.

# --- Backend ---
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
MAX_PHOTO_MB=10
MAX_TRANSCRIPT_CHARS=20000

# --- ElevenLabs (speech-to-text and narration). Paste-a-transcript works without it. ---
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Recipe writer: Gemma via the Gemini API free tier (key: https://aistudio.google.com/apikey).
# Any OpenAI-compatible endpoint works. Local Ollama instead:
#   LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=gemma3:4b  LLM_API_KEY=ollama
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemma-4-26b-a4b-it
LLM_API_KEY=
LLM_TIMEOUT=240
# Free tiers are rate limited: calls per minute (0 = no limit) and max seconds to wait on a 429.
LLM_MAX_RPM=10
LLM_MAX_WAIT=45
# Gemma 4 on Google: minimal thinking answers in seconds instead of minutes. Empty = provider default.
LLM_THINKING_LEVEL=minimal
# Quota guards for a public demo: model calls per day, and quota-spending requests per visitor per 10 minutes.
LLM_MAX_PER_DAY=300
SUBMIT_LIMIT=8

# --- Frontend (frontend/.env) ---
# VITE_API_URL=http://localhost:8000

# --- Accounts (Sign in with Google) ---
# OAuth Client ID from Google Cloud Console (public, not a secret). Empty = sign-in off:
# local development then uses one built-in account; production refuses all requests.
GOOGLE_CLIENT_ID=
# Long random string that signs sessions (secret). Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Optional: only these Google accounts may sign in (comma-separated). Empty = anyone.
ALLOWED_EMAILS=
# Recipes (and narrations) each account may create per day. 0 = unlimited.
USER_DAILY_LIMIT=5
# Anti-spam: throwaway email domains are always refused; add more here (comma-separated).
BLOCKED_EMAIL_DOMAINS=
# Per network (IP, stored only as a salted hash): new accounts per day, AI requests per day. 0 = off.
ACCOUNTS_PER_IP_PER_DAY=2
IP_DAILY_LIMIT=10
# Header with the visitor's real IP: true-client-ip on Render, x-real-ip behind nginx. Empty = direct.
CLIENT_IP_HEADER=
